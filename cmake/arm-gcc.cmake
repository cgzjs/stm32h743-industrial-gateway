set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(DEFINED ENV{ARM_GCC_DIR})
  set(ARM_BIN "$ENV{ARM_GCC_DIR}")
elseif(WIN32)
  file(GLOB ARM_BINS "$ENV{LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/*/bin")
  list(SORT ARM_BINS COMPARE NATURAL ORDER DESCENDING)
  if(ARM_BINS)
    list(GET ARM_BINS 0 ARM_BIN)
  endif()
endif()
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS "${ARM_BIN}" REQUIRED)
set(CMAKE_ASM_COMPILER ${CMAKE_C_COMPILER})
find_program(CMAKE_OBJCOPY arm-none-eabi-objcopy HINTS "${ARM_BIN}" REQUIRED)
find_program(CMAKE_SIZE arm-none-eabi-size HINTS "${ARM_BIN}" REQUIRED)
